// Auto-generated Blueprint for hardware/interfaces (framework extractive)
// Staged from Extractive APEX package: org.blisslabs.ag.ext.hardware-interfaces

package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

license {
    name: "hardware_interfaces_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-NCSA",
    ],
    license_text: [
        "NOTICE",
    ],
}

hidl_package_root {
    name: "android.hardware",
    use_current: true,
}

